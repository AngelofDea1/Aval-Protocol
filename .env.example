# Aval Protocol - environment template
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is not, because a clone with no
# template cannot be configured.
#
#   cp .env.example .env
#
# Or run `bash script/setup-env.sh`, which writes most of this for you.
#
# ---------------------------------------------------------------------------------------
# KEYS. Read this before pasting anything below.
#
# Use throwaway wallets. Every key here signs transactions that move money, and a key that
# has ever been pasted into a chat window, a terminal shared on a call, or a screen recording
# is compromised permanently. Fund them with only what a demo needs.
#
# Never commit `.env`. Never paste its contents anywhere.
# ---------------------------------------------------------------------------------------


# ------------------------------------------------------------------ signers

# Deploys the contracts and owns them until ownership is transferred.
PRIVATE_KEY=

# The AI underwriter. Signs attestations and posts the first-loss bond.
# MUST be a different key from PRIVATE_KEY: the demo has the owner and the underwriter act
# as separate parties, and several checks assert they are not the same address.
UNDERWRITER_PRIVATE_KEY=

# Optional. Runs the settlement keeper. Falls back to PRIVATE_KEY if unset.
# settle() is permissionless, so this key needs gas and nothing else.
KEEPER_PRIVATE_KEY=

# Receives ownership at deploy. For the testnet demo this equals the deployer address;
# deploy-testnet.sh refuses to run otherwise, because the seed step needs owner rights.
# BEFORE MAINNET this should be a multisig. See SECURITY.md, "Accepted risks".
OWNER_ADDRESS=


# ------------------------------------------------------------------ network

# Testnet is chain 1952. Chain 195 is the old deprecated testnet - do not use it.
XLAYER_TESTNET_RPC_URL=https://testrpc.xlayer.tech/terigon

# Mainnet is chain 196.
XLAYER_RPC_URL=https://rpc.xlayer.tech


# ------------------------------------------------------------------ deployment

# Written by deploy-testnet.sh / deploy-mainnet.sh. Leave blank on a first deploy.
#
# On testnet these point at MockUSDT and a fresh deployment.
# On mainnet, USDT_ADDRESS is bridged Tether: 0x1e4a5963abFD975d8c9021ce480b42188849D41d
USDT_ADDRESS=
DEAL_MANAGER_ADDRESS=
VAULT_ADDRESS=
REGISTRY_ADDRESS=
REPUTATION_ADDRESS=
ADAPTER_ADDRESS=
DEPLOY_BLOCK=

# Minimum bond an underwriter must lock to register, in USDT at 6 decimals.
#
# The contract default is 10_000e6 - ten thousand USDT. That is fine against MockUSDT and
# ruinous against real USDT, where it means nobody can register without ten thousand real
# dollars. Set this explicitly for any mainnet deploy.
#
#   MIN_BOND=10000000       # 10 USDT
MIN_BOND=

# The model version an underwriter commits to onchain. Printed by `npm run underwrite`.
MODEL_COMMIT=


# ------------------------------------------------------------------ the model

# Optional. Enables stage 2 of the model, a bounded LLM adjustment over unstructured context.
# Without it, underwriting runs on the structural model alone and records the skip in the
# rationale - it degrades, it does not fail.
GROQ_API_KEY=
LLM_MODEL=llama3-70b-8192


# ------------------------------------------------------------------ verification

# From https://www.oklink.com - needed only by `npm run verify`.
OKLINK_API_KEY=


# ------------------------------------------------------------------ ownership transfer

# Used by script/transfer-ownership.sh. Should be a multisig.
NEW_OWNER=

# Set to 1 only if you have deliberately decided to hand ownership to an EOA. The script
# refuses otherwise, on purpose.
ALLOW_EOA_OWNER=
