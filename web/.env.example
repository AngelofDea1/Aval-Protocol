# Aval Protocol web - environment template
#
#   cd web && cp .env.example .env.local
#
# Anything prefixed NEXT_PUBLIC_ is compiled into the browser bundle and readable by anyone.
# Never put a secret behind that prefix.
#
# Two variables at the bottom are NOT public. They are read only inside /api/underwrite, which
# runs on the server, and they must be set as environment variables on the host rather than
# committed anywhere.
#
# All of these are OPTIONAL. With none of them set, the app falls back to the values in
# lib/facts.ts, which is the live testnet deployment. Set them to point a build at a
# different deployment without editing source.


# Which deployment this build talks to. "testnet" (chain 1952) or "mainnet" (chain 196).
NEXT_PUBLIC_NETWORK=testnet

# Override the RPC endpoint. Users can also set their own from the settings inside the app.
NEXT_PUBLIC_RPC_URL=

# Contract addresses. Written by the deploy script; copy them from its output.
#
# On testnet these are optional and fall back to the live deployment baked into lib/facts.ts.
# With NEXT_PUBLIC_NETWORK=mainnet the first five are REQUIRED and the build throws without
# them, so a mainnet build cannot ship testnet addresses under a mainnet heading.
NEXT_PUBLIC_DEAL_MANAGER=
NEXT_PUBLIC_VAULT=
NEXT_PUBLIC_REGISTRY=
NEXT_PUBLIC_REPUTATION=
NEXT_PUBLIC_ADAPTER=
NEXT_PUBLIC_USDT=

# The block the contracts were deployed at. Log queries start here instead of at genesis,
# which is the difference between a deal list that loads and one that times out.
NEXT_PUBLIC_DEPLOY_BLOCK=

# Canonical origin, used for absolute URLs in the agent manifest, robots.txt, sitemap and
# social card. On Vercel this is derived automatically; set it for any other host.
NEXT_PUBLIC_SITE_URL=


# ================================================================== SERVER ONLY
#
# Not NEXT_PUBLIC_. Never prefix these. They stay on the server.

# The AI underwriter's signing key. /api/underwrite uses it to sign an EIP-712 attestation so a
# visitor can fund a loan from the Borrow tab.
#
# WITHOUT THIS, the Borrow button returns 503 and says the deployment cannot sign. That is the
# single most likely reason borrowing "does not work" after a deploy: the code is fine and the
# key is missing.
#
# Use a throwaway key holding only testnet value. The route refuses chain 196 outright, because
# fundDeal does not tie a borrower to the revenue being scored and an open signing endpoint on
# mainnet would let anyone borrow against a business they have nothing to do with. See
# SECURITY.md, "Browser underwriting is testnet only".
UNDERWRITER_PRIVATE_KEY=

# Optional. The ProtocolRevenueAdapter, recorded on each deal so the Loans tab can show a
# business name instead of a bare address. Falls back to the zero address.
ADAPTER_ADDRESS=
